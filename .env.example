# Local docker-compose Postgres. Production: Neon Free (set DATABASE_URL on Fly secrets).
DATABASE_URL=postgres://scenic:scenic@127.0.0.1:5432/scenic_route

OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=meta/muse-image
# Optional image-capable chat model for the separate poster evaluation CLI.
OPENROUTER_JUDGE_MODEL=
# Per image; multi-image requests multiply this deadline by n. Default: 10 minutes.
OPENROUTER_IMAGE_TIMEOUT_MS=600000
# Shared image scheduler: global active requests and active requests per authenticated user.
# Unfinished admission defaults to 16 jobs per user (active, waiting, and retry backoff); there is no global image waiting cap.
# Initial global capacity is seeded on first migration; subsequent changes use jobs:control capacity.
OPENROUTER_IMAGE_CONCURRENCY=128
OPENROUTER_IMAGE_USER_CONCURRENCY=8

R2_ACCOUNT_ID=
R2_BUCKET=scenic-route-posters
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

FLY_APP_NAME=scenic-route

# Local. Production (Fly): https://scenic-route.ca
WEB_ORIGIN=http://localhost:5174
PORT=8790

BETTER_AUTH_SECRET=
# Local. Production (Fly): https://scenic-route.ca
BETTER_AUTH_URL=http://localhost:5174
# Google OAuth web client; callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# After verifying scenic-route.ca in Resend, e.g. Scenic Route <info@scenic-route.ca>
RESEND_FROM=
BOOTSTRAP_EMAIL=

# Set only after reviewed policy pages are integrated and published at these routes.
# Empty values fail closed for protected use; never use a draft policy version.
TERMS_VERSION=
AI_CONSENT_VERSION=
TERMS_ROUTE=
PRIVACY_ROUTE=

# OSM Standard raster proxy: persistent local cache; no Fly volume needed in development.
OSM_TILES_ENABLED=true
# Local default: data/tile-cache. Production Fly volume: /tile-cache.
# OSM_TILE_CACHE_DIR=
OSM_TILE_CACHE_MAX_BYTES=2147483648
OSM_TILE_CACHE_MAX_ENTRIES=50000
# Local default: WEB_ORIGIN. Production defaults: scenic-route.ca and scenic-route.fly.dev.
# OSM_TILE_ALLOWED_ORIGINS=

# Runtime roles are selected by npm run dev / runtime.ts arguments.
# IMAGE_WORKER_CONCURRENCY=64
PG_QUERY_POOL_SIZE=10
PG_ACCOUNT_POOL_SIZE=8

# Independent minimum levels: debug, info, warn, error, off.
# Geography and optional OSM diagnostics use debug; normal console logs use info.
LOG_FILE_LEVEL=debug
LOG_CONSOLE_LEVEL=info
# Default: data/logs, with one append-only JSONL file per UTC day.
# LOG_DIR=
