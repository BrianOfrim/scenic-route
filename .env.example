# Local docker-compose Postgres. Production: Neon Free (set DATABASE_URL on Fly secrets).
DATABASE_URL=postgres://scenic:scenic@127.0.0.1:5432/scenic_route

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Local. Production (Fly): https://scenic-route.ca/api/strava/callback
STRAVA_REDIRECT_URI=http://localhost:5174/api/strava/callback

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst

R2_ACCOUNT_ID=
R2_BUCKET=scenic-route-posters
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

FLY_APP_NAME=scenic-route

# Local. Production (Fly): https://scenic-route.ca
WEB_ORIGIN=http://localhost:5174
PORT=8790

BETTER_AUTH_SECRET=
# Local. Production (Fly): https://scenic-route.ca
BETTER_AUTH_URL=http://localhost:5174
RESEND_API_KEY=
# After verifying scenic-route.ca in Resend, e.g. Scenic Route <signin@scenic-route.ca>
RESEND_FROM=
BOOTSTRAP_EMAIL=
