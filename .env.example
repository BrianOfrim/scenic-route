# Local docker-compose Postgres. Production: Neon Free (set DATABASE_URL on Fly secrets).
DATABASE_URL=postgres://scenic:scenic@127.0.0.1:5432/scenic_route

OPENROUTER_API_KEY=
# Chat model is needed only for modifying an existing poster.
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
OPENROUTER_IMAGE_MODEL=meta/muse-image
# Per image; multi-image requests multiply this deadline by n. Default: 10 minutes.
OPENROUTER_IMAGE_TIMEOUT_MS=600000
# Image generation worker and provider request limit.
OPENROUTER_IMAGE_CONCURRENCY=4
# Chat request limit for poster modification (legacy variable name).
OPENROUTER_PLAN_CONCURRENCY=4

R2_ACCOUNT_ID=
R2_BUCKET=scenic-route-posters
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

FLY_APP_NAME=scenic-route

# Local. Production (Fly): https://scenic-route.ca
WEB_ORIGIN=http://localhost:5174
PORT=8790

BETTER_AUTH_SECRET=
# Local. Production (Fly): https://scenic-route.ca
BETTER_AUTH_URL=http://localhost:5174
# Google OAuth web client; callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# After verifying scenic-route.ca in Resend, e.g. Scenic Route <info@scenic-route.ca>
RESEND_FROM=
BOOTSTRAP_EMAIL=
