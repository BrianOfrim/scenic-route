{
  "name": "scenic-route",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "poster:limit": "tsx scripts/set-poster-limit.mts",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @scenic-route/api\" \"npm run dev -w @scenic-route/web\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev:api": "npm run dev -w @scenic-route/api",
    "dev:web": "npm run dev -w @scenic-route/web",
    "test": "npm test -w @scenic-route/api && npm test -w @scenic-route/web",
    "test:api": "npm test -w @scenic-route/api",
    "test:web": "npm test -w @scenic-route/web",
    "build": "npm run build -w @scenic-route/web",
    "beta:admit": "tsx scripts/admit-beta.mts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
